<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- Prevent MailKit vulnerability warning from failing the build -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="MailKit" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Platform.Domain\Platform.Domain.csproj" />
  </ItemGroup>
</Project>
