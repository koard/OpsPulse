OPSPULSE_DOMAIN=ops.example.com

POSTGRES_DB=opspulse
POSTGRES_USER=opspulse
POSTGRES_PASSWORD=change-me-long-random-password

DUKEFARM_AGENT_TOKEN=change-me-long-random-token

MONITORED_PROJECT_ID=dukefarm

GITHUB_TOKEN=ghp_change-me-readonly-token
GITHUB_WEBHOOK_SECRET=change-me-long-random-webhook-secret

DUKEFARM_BACKEND_REPO=koard/DukeFarm-Backend
DUKEFARM_FRONTEND_REPO=koard/DukeFarm-Frontend
DUKEFARM_ADMIN_REPO=koard/DukeFarm-Admin

PROJECT_REGISTRY_IMAGE=opspulse-project-registry:latest
TELEMETRY_IMAGE=opspulse-telemetry:latest
GATEWAY_IMAGE=opspulse-gateway:latest
ALERTING_IMAGE=opspulse-alerting:latest
WEB_IMAGE=opspulse-web:latest

# ── Alert Email Notification ───────────────────────────────────
# ถ้าไม่ตั้งค่า SMTP ระบบจะข้ามการส่งเมลโดยอัตโนมัติ
# Gmail App Password: https://myaccount.google.com/apppasswords
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your@gmail.com
ALERT_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
ALERT_EMAIL_FROM=OpsPulse <your@gmail.com>
ALERT_EMAIL_TO=you@example.com
ALERT_COOLDOWN_MINUTES=30
